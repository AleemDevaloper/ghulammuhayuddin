  "templates": [
    {
      "id": "TP-201",
      "name": "First introduction",
      "category": "First touch",
      "subject": "A short idea for {{company}}",
      "body": "Hi {{first_name}},\n\nI noticed {{company}} works with growing teams. I wanted to share one practical idea for improving lead handoffs and follow-up visibility without adding more admin work.\n\nWould a brief introduction be useful?\n\nBest,\n{{sender_name}}\n\n{{unsubscribe_link}}",
      "status": "Approved"
    },
    {
      "id": "TP-202",
      "name": "Helpful follow-up",
      "category": "Follow-up",
      "subject": "Following up on my note",
      "body": "Hi {{first_name}},\n\nJust following up in case my earlier message got buried. If improving your current workflow is something you are exploring, I can share a concise example relevant to {{company}}.\n\nNo rush either way.\n\nBest,\n{{sender_name}}\n\n{{unsubscribe_link}}",
      "status": "Approved"
    },
    {
      "id": "TP-203",
      "name": "Value-led check-in",
      "category": "Follow-up",
      "subject": "One workflow improvement to consider",
      "body": "Hi {{first_name}},\n\nA quick thought: teams often save review time by keeping qualification and message approval in a single workspace. Happy to compare notes if this is relevant at {{company}}.\n\nBest,\n{{sender_name}}\n\n{{unsubscribe_link}}",
      "status": "Draft"
    },
    {
      "id": "TP-204",
      "name": "Meeting confirmation",
      "category": "Reply",
      "subject": "Confirming our conversation",
      "body": "Hi {{first_name}},\n\nThanks for your reply. I would be glad to walk through the process and answer any questions. Please suggest a convenient time using our agreed communication channel.\n\nBest,\n{{sender_name}}",
      "status": "Approved"
    },
    {
      "id": "TP-205",
      "name": "Close the loop",
      "category": "Breakup",
      "subject": "Closing the loop for now",
      "body": "Hi {{first_name}},\n\nI do not want to crowd your inbox. I will close the loop on my side for now. If workflow automation becomes relevant later, I would be glad to reconnect.\n\nBest,\n{{sender_name}}\n\n{{unsubscribe_link}}",
      "status": "Approved"
    }
  ],
